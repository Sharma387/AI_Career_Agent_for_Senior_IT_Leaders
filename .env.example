# =============================================================================
# AI Career Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- LLM Configuration ---
LLM_PROVIDER=ollama                    # Options: ollama (free local), nvidia, anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Nvidia (optional — only if LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Anthropic (optional — only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Authentication ---
JWT_SECRET_KEY=change-this-to-a-random-string-in-production

# --- Adzuna Job API (free tier: 250 calls/month) ---
# Register at: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=nz                      # nz, au, gb, us, etc.

# --- Seek Automation (Playwright) ---
SEEK_SCRAPING_ENABLED=true
SEEK_CHROME_PROFILE_PATH=              # Path to dedicated Chrome profile directory
SEEK_HEADLESS=true
SEEK_MAX_PAGES_PER_SEARCH=3
SEEK_REQUEST_DELAY_MIN=2.0
SEEK_REQUEST_DELAY_MAX=5.0
SEEK_DAILY_SCRAPE_HOUR=7               # NZ time (24h format)
SEEK_DAILY_SCRAPE_MINUTE=0
SEEK_ROLE_PRESETS=project-manager,sr-project-manager,it-manager,engineering-manager,it-director,cto

# --- LinkedIn Extension ---
LINKEDIN_EXTENSION_ENABLED=true

# --- Scheduler ---
SCHEDULER_TIMEZONE=Pacific/Auckland
SCHEDULER_INCREMENTAL_ENABLED=true
SCHEDULER_FULL_ENABLED=true

# --- Debug ---
DEBUG=true
